# Base URL of this app (used to build the OAuth redirect)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase project settings → Database → Connection string ("Transaction" pooler, port 6543)
# Used by Drizzle (drizzle.config.ts, src/db/index.ts) and db:seed
DATABASE_URL=postgresql://postgres.your-project:your-db-password@aws-0-region.pooler.supabase.com:6543/postgres
